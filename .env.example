# "tide" = real TideCloak tokens (needs a real tidecloak.json).
# "dev"  = local signed tokens + one-click demo users, for building UI before TideCloak is ready.
# If unset: "dev" while tidecloak.json is still the placeholder, otherwise "tide".
NEXT_PUBLIC_GUARDIAN_AUTH_MODE=dev

# Only used in dev mode to sign the fake tokens. Anything long and random.
GUARDIAN_DEV_SECRET=change-me-to-a-long-random-string

# Enables POST /api/demo/tamper (simulates a rogue database admin for the demo).
GUARDIAN_ENABLE_TAMPER_DEMO=1

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Neon — paste connection string when ready. Without it, in-memory store is used.
